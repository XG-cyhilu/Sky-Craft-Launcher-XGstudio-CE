{
  "name": "sclce",
  "version": "2.0.5",
  "description": "Sky Craft Launcher CE by XG STUDIO",
  "author": "XG STUDIO",
  "license": "GNU GPLv3.0",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/main/index.cjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "node scripts/start.cjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "node scripts/ui-test.mjs",
    "test:launch": "node scripts/launch-test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "productName": "SCLce",
  "build": {
    "appId": "studio.sclce.launcher",
    "productName": "SCLCE",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "resources/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SCLCE",
      "artifactName": "SCLCE-Setup-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 XG STUDIO"
  },
  "homepage": "https://github.com/XG-cyhilu/Sky-Craft-Launcher-XGstudio-CE",
  "repository": {
    "type": "git",
    "url": "https://github.com/XG-cyhilu/Sky-Craft-Launcher-XGstudio-CE.git"
  },
  "bugs": {
    "url": "https://github.com/XG-cyhilu/Sky-Craft-Launcher-XGstudio-CE/issues"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron",
    "react",
    "fabric",
    "forge",
    "neoforge",
    "modrinth"
  ]
}
